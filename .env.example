# URL de l'instance Railway, sans slash final
SYNC_URL=https://your-app.up.railway.app

# Identifiants admin (mêmes que ADMIN_USER / ADMIN_PASS configurés sur Railway)
#
# ⚠️ ADMIN_PASS est OBLIGATOIRE : sans lui, le serveur REFUSE de démarrer.
# Ce n'est pas une précaution de confort — la variable absente ouvrait toute
# l'écriture /api aux requêtes anonymes, promotion admin comprise. `npm start`
# charge ce fichier via `--env-file-if-exists`, donc le renseigner ici suffit
# en local ; en production, c'est l'hébergeur qui injecte la variable.
ADMIN_USER=admin
ADMIN_PASS=changeme

# Durée de vie des sessions joueur (cookie), en jours
SESSION_TTL_DAYS=30

# Intégration Notion
NOTION_TOKEN=secret_xxx
NOTION_SYNC_PAGE_ID=
NOTION_TASK_PAGE_ID=
# ID de la page "Brainstorm — Soulforge" (sous-pages créées par /handle-design-tickets)
NOTION_BRAINSTORM_PAGE_ID=

# Clé API Anthropic, utilisée par scripts/gdd-sync.sh (hook post-commit) en mode headless
ANTHROPIC_API_KEY=sk-ant-xxx
